<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MHTMLReader" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/textOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/textOnPrimaryContainer</item>
        <item name="colorSecondary">@color/textSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSurfaceHighlight</item>
        <item name="colorOnSecondaryContainer">@color/textPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>
        <item name="colorOutline">@color/colorStroke</item>
        <item name="android:fontFamily">sans</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>

        <!-- Standard texts -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorTertiary">@color/textTertiary</item>

        <!-- Surface and Floating -->
        <item name="colorBackgroundFloating">@color/colorSurface</item>
        
        <!-- Controls -->
        <item name="colorControlNormal">@color/colorStroke</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorSurfaceHighlight</item>
        
        <!-- Button styles -->
        <item name="android:buttonStyle">@style/Widget.MHTMLReader.Button</item>
        <item name="buttonStyle">@style/Widget.MHTMLReader.Button</item>
        <item name="materialButtonStyle">@style/Widget.MHTMLReader.Button</item>
    </style>

    <style name="Widget.MHTMLReader.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/home_action_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MHTMLReader.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/home_action_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MHTMLReader.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.MHTMLReader.NavigationIndicator</item>
    </style>

    <style name="Widget.MHTMLReader.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryContainer</item>
    </style>
</resources>
