<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_density_horizontal_padding"
        android:paddingTop="@dimen/home_density_top_padding"
        android:paddingEnd="@dimen/home_density_horizontal_padding"
        android:paddingBottom="@dimen/home_density_bottom_padding">

        <TextView
            android:id="@+id/home_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_home_title"
            android:textColor="@color/textPrimary"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/home_page_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ui_home_subtitle"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/home_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_card_bg"
            android:elevation="@dimen/home_card_elevation"
            android:orientation="horizontal"
            android:padding="@dimen/home_density_card_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_recents_button"
                style="@style/Widget.MHTMLReader.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/home_density_action_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:drawableStart="@drawable/ic_nav_tabs"
                android:drawableTint="@color/textOnPrimary"
                android:drawablePadding="8dp"
                android:text="@string/home_recent_opens" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_favorites_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/home_density_action_min_height"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:drawableStart="@drawable/ic_nav_folders"
                android:drawableTint="@color/textPrimary"
                android:drawablePadding="8dp"
                android:text="@string/home_favorites_shortcut" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_density_section_spacing"
            android:background="@drawable/home_card_bg"
            android:elevation="@dimen/home_card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/home_density_card_padding">

            <TextView
                android:id="@+id/home_storage_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_storage_sources"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_spacing_xsmall"
                android:text="@string/home_local_dirs"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <ListView
                android:id="@+id/home_local_list"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_density_list_initial_height"
                android:layout_marginTop="@dimen/home_spacing_xsmall"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/home_spacing_small"
                android:overScrollMode="never"
                android:paddingTop="@dimen/home_spacing_xsmall"
                android:paddingBottom="@dimen/home_spacing_xsmall"
                android:scrollbars="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_density_group_spacing"
                android:text="@string/home_sd_card"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <ListView
                android:id="@+id/home_sd_list"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_density_list_initial_height"
                android:layout_marginTop="@dimen/home_spacing_xsmall"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/home_spacing_small"
                android:overScrollMode="never"
                android:paddingTop="@dimen/home_spacing_xsmall"
                android:paddingBottom="@dimen/home_spacing_xsmall"
                android:scrollbars="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_density_section_spacing"
            android:background="@drawable/home_card_bg"
            android:elevation="@dimen/home_card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/home_density_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_network_title"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_spacing_xsmall"
                android:text="@string/home_network_subtitle"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <ListView
                android:id="@+id/home_network_list"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_density_list_initial_height"
                android:layout_marginTop="@dimen/home_spacing_small"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/home_spacing_small"
                android:overScrollMode="never"
                android:paddingTop="@dimen/home_spacing_xsmall"
                android:paddingBottom="@dimen/home_spacing_xsmall"
                android:scrollbars="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
